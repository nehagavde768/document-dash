# Copy to .env.production (or .env.local) and adjust before building for the kiosk.

# Home page the Home buttons and the kiosk return to between players. Defaults to the
# Rajyotsav portal's home page; set it only to use a different one.
# VITE_LAUNCHER_URL=https://cggeomap.cgstate.gov.in/rajyotsav_portal/modules/home/home.html

# This game's name as printed on the winner's certificate (plain words, no underscores)
VITE_GAME_NAME="Document Dash"

# Round length in seconds (default 120, the 2-minute countdown). 0 = no time limit and no
# clock, for testing.
# VITE_TIME_LIMIT_SECONDS=120

# Certificate service endpoint (defaults to the Rajyotsav certificate API)
# VITE_CERTIFICATE_API_URL=https://cggeomap.cgstate.gov.in/rajyotsav/api/certificate
